# ===== GoWind Admin — backendr (Rust/axum) 环境变量示例 =====
# 复制为 .env 后按需修改

# 运行环境: dev | test | prod
GW_ADMIN_ENV=dev

# HTTP 监听地址（与 backendz 错开端口，后端已是 :7788）
GW_ADMIN_HTTP_ADDR=0.0.0.0:7666

# SQL 连接（sqlx AnyPool，支持 postgres://  mysql://  sqlite://）
GW_ADMIN_DATABASE_URL=mysql://root:root@127.0.0.1:3306/gowind_admin?charset=utf8mb4&parseTime=true&loc=Local

# Redis
GW_ADMIN_REDIS_URL=redis://127.0.0.1:6379

# 鉴权
GW_ADMIN_JWT_SECRET=dev-secret-change-me
GW_ADMIN_DEFAULT_TENANT_ID=1

# 请求体上限（字节）
GW_ADMIN_MAX_BODY_BYTES=10485760