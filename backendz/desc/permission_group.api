import "common.api"

// 本分组类型定义

type CreatePermissionGroupRequest {
	Data	PermissionGroup	`json:"data,optional"`
}

type ListPermissionGroupResponse {
	Items	[]PermissionGroup	`json:"items,optional"`
	Total	string	`json:"total,optional"`
}

type PermissionGroup {
	Id	int64	`json:"id,optional"`
	Name	string	`json:"name,optional"`
	Path	string	`json:"path,optional"`
	Module	string	`json:"module,optional"`
	SortOrder	int64	`json:"sortOrder,optional"`
	Status	string	`json:"status,optional"`
	Description	string	`json:"description,optional"`
	ParentId	int64	`json:"parentId,optional"`
	Children	[]PermissionGroup	`json:"children,optional"`
	CreatedBy	int64	`json:"createdBy,optional"`
	UpdatedBy	int64	`json:"updatedBy,optional"`
	DeletedBy	int64	`json:"deletedBy,optional"`
	CreatedAt	string	`json:"createdAt,optional"`
	UpdatedAt	string	`json:"updatedAt,optional"`
	DeletedAt	string	`json:"deletedAt,optional"`
}

type UpdatePermissionGroupRequest {
	Id	int64	`path:"id,optional"`
	Data	PermissionGroup	`json:"data,optional"`
	UpdateMask	string	`json:"updateMask,optional"`
	AllowMissing	bool	`json:"allowMissing,optional"`
}

type PermissionGroupDeleteReq {
	Id	int64	`path:"id,optional"`
}

type PermissionGroupGetReq {
	Id	int64	`path:"id,optional"`
	ViewMask	string	`form:"viewMask,optional"`
}



@server (
	prefix: "/admin/v1/permission-groups"
	group: permission_group
)

service admin-api {
	@handler PermissionGroupList
	get / (PageRequest) returns (ListPermissionGroupResponse)

	@handler PermissionGroupCreate
	post / (CreatePermissionGroupRequest)

	@handler PermissionGroupGet
	get /:id (PermissionGroupGetReq) returns (PermissionGroup)

	@handler PermissionGroupUpdate
	put /:id (UpdatePermissionGroupRequest)

	@handler PermissionGroupDelete
	delete /:id (PermissionGroupDeleteReq)
}
