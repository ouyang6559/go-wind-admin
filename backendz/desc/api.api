import "common.api"

// 本分组类型定义

type Api {
	Id	int64	`json:"id,optional"`
	Operation	string	`json:"operation,optional"`
	Path	string	`json:"path,optional"`
	Method	string	`json:"method,optional"`
	Module	string	`json:"module,optional"`
	ModuleDescription	string	`json:"moduleDescription,optional"`
	BusinessModule	string	`json:"businessModule,optional"`
	Description	string	`json:"description,optional"`
	Scope	string	`json:"scope,optional"`
	Status	string	`json:"status,optional"`
	CreatedBy	int64	`json:"createdBy,optional"`
	UpdatedBy	int64	`json:"updatedBy,optional"`
	DeletedBy	int64	`json:"deletedBy,optional"`
	CreatedAt	string	`json:"createdAt,optional"`
	UpdatedAt	string	`json:"updatedAt,optional"`
	DeletedAt	string	`json:"deletedAt,optional"`
}

type CreateApiRequest {
	Data	Api	`json:"data,optional"`
}

type ListApiResponse {
	Items	[]Api	`json:"items,optional"`
	Total	string	`json:"total,optional"`
}

type UpdateApiRequest {
	Id	int64	`path:"id,optional"`
	Data	Api	`json:"data,optional"`
	UpdateMask	string	`json:"updateMask,optional"`
	AllowMissing	bool	`json:"allowMissing,optional"`
}

type ApiDeleteReq {
	Id	int64	`path:"id,optional"`
}

type ApiGetReq {
	Id	int64	`path:"id,optional"`
	ViewMask	string	`form:"viewMask,optional"`
}



@server (
	prefix: "/admin/v1/apis"
	group: api
)

service admin-api {
	@handler ApiList
	get / (PageRequest) returns (ListApiResponse)

	@handler ApiCreate
	post / (CreateApiRequest)

	@handler ApiSyncApis
	post /sync

	@handler ApiGetWalkRouteData
	get /walk-route returns (ListApiResponse)

	@handler ApiGet
	get /:id (ApiGetReq) returns (Api)

	@handler ApiUpdate
	put /:id (UpdateApiRequest)

	@handler ApiDelete
	delete /:id (ApiDeleteReq)
}
