import "common.api"

// 本分组类型定义

type CreateOrgUnitRequest {
	Data	OrgUnit	`json:"data,optional"`
}

type ListOrgUnitResponse {
	Items	[]OrgUnit	`json:"items,optional"`
	Total	int64	`json:"total,optional"`
}

type OrgUnit {
	Id	int64	`json:"id,optional"`
	Name	string	`json:"name,optional"`
	Code	string	`json:"code,optional"`
	Type	string	`json:"type,optional"`
	Path	string	`json:"path,optional"`
	Status	string	`json:"status,optional"`
	SortOrder	int64	`json:"sortOrder,optional"`
	LeaderId	int64	`json:"leaderId,optional"`
	LeaderName	string	`json:"leaderName,optional"`
	TenantId	int64	`json:"tenantId,optional"`
	TenantName	string	`json:"tenantName,optional"`
	Remark	string	`json:"remark,optional"`
	Description	string	`json:"description,optional"`
	BusinessScopes	[]string	`json:"businessScopes,optional"`
	ExternalId	string	`json:"externalId,optional"`
	IsLegalEntity	bool	`json:"isLegalEntity,optional"`
	RegistrationNumber	string	`json:"registrationNumber,optional"`
	TaxId	string	`json:"taxId,optional"`
	LegalEntityOrgId	int64	`json:"legalEntityOrgId,optional"`
	Address	string	`json:"address,optional"`
	Phone	string	`json:"phone,optional"`
	Email	string	`json:"email,optional"`
	Timezone	string	`json:"timezone,optional"`
	Country	string	`json:"country,optional"`
	Latitude	float64	`json:"latitude,optional"`
	Longitude	float64	`json:"longitude,optional"`
	StartAt	string	`json:"startAt,optional"`
	EndAt	string	`json:"endAt,optional"`
	Attributes	map[string]interface{}	`json:"attributes,optional"`
	PermissionTags	[]string	`json:"permissionTags,optional"`
	ContactUserId	int64	`json:"contactUserId,optional"`
	ContactUserName	string	`json:"contactUserName,optional"`
	ParentId	int64	`json:"parentId,optional"`
	Children	[]OrgUnit	`json:"children,optional"`
	CreatedBy	int64	`json:"createdBy,optional"`
	UpdatedBy	int64	`json:"updatedBy,optional"`
	DeletedBy	int64	`json:"deletedBy,optional"`
	CreatedAt	string	`json:"createdAt,optional"`
	UpdatedAt	string	`json:"updatedAt,optional"`
	DeletedAt	string	`json:"deletedAt,optional"`
}

type UpdateOrgUnitRequest {
	Id	int64	`path:"id,optional"`
	Data	OrgUnit	`json:"data,optional"`
	UpdateMask	string	`json:"updateMask,optional"`
	AllowMissing	bool	`json:"allowMissing,optional"`
}

type OrgUnitDeleteReq {
	Id	int64	`path:"id,optional"`
}

type OrgUnitGetReq {
	Id	int64	`path:"id,optional"`
	ViewMask	string	`form:"viewMask,optional"`
}



@server (
	prefix: "/admin/v1/org-units"
	group: org_unit
)

service admin-api {
	@handler OrgUnitList
	get / (PageRequest) returns (ListOrgUnitResponse)

	@handler OrgUnitCreate
	post / (CreateOrgUnitRequest)

	@handler OrgUnitGet
	get /:id (OrgUnitGetReq) returns (OrgUnit)

	@handler OrgUnitUpdate
	put /:id (UpdateOrgUnitRequest)

	@handler OrgUnitDelete
	delete /:id (OrgUnitDeleteReq)
}
