import "common.api"

// 本分组类型定义

type ListOperationAuditLogResponse {
	Items	[]OperationAuditLog	`json:"items,optional"`
	Total	string	`json:"total,optional"`
}

type OperationAuditLog {
	Id	int64	`json:"id,optional"`
	TenantId	int64	`json:"tenantId,optional"`
	TenantName	string	`json:"tenantName,optional"`
	UserId	int64	`json:"userId,optional"`
	Username	string	`json:"username,optional"`
	ResourceType	string	`json:"resourceType,optional"`
	ResourceId	string	`json:"resourceId,optional"`
	Action	string	`json:"action,optional"`
	BeforeData	string	`json:"beforeData,optional"`
	AfterData	string	`json:"afterData,optional"`
	SensitiveLevel	string	`json:"sensitiveLevel,optional"`
	RequestId	string	`json:"requestId,optional"`
	TraceId	string	`json:"traceId,optional"`
	Success	bool	`json:"success,optional"`
	FailureReason	string	`json:"failureReason,optional"`
	IpAddress	string	`json:"ipAddress,optional"`
	GeoLocation	GeoLocation	`json:"geoLocation,optional"`
	LogHash	string	`json:"logHash,optional"`
	Signature	string	`json:"signature,optional"`
	CreatedAt	string	`json:"createdAt,optional"`
}

type OperationAuditLogGetReq {
	Id	int64	`path:"id,optional"`
	ViewMask	string	`form:"viewMask,optional"`
}



@server (
	prefix: "/admin/v1/operation-audit-logs"
	group: operation_audit_log
)

service admin-api {
	@handler OperationAuditLogList
	get / (PageRequest) returns (ListOperationAuditLogResponse)

	@handler OperationAuditLogGet
	get /:id (OperationAuditLogGetReq) returns (OperationAuditLog)
}
