import "common.api"

// 本分组类型定义

type ListLoginAuditLogResponse {
	Items	[]LoginAuditLog	`json:"items,optional"`
	Total	string	`json:"total,optional"`
}

type LoginAuditLog {
	Id	int64	`json:"id,optional"`
	TenantId	int64	`json:"tenantId,optional"`
	TenantName	string	`json:"tenantName,optional"`
	UserId	int64	`json:"userId,optional"`
	Username	string	`json:"username,optional"`
	IpAddress	string	`json:"ipAddress,optional"`
	GeoLocation	GeoLocation	`json:"geoLocation,optional"`
	SessionId	string	`json:"sessionId,optional"`
	DeviceInfo	DeviceInfo	`json:"deviceInfo,optional"`
	RequestId	string	`json:"requestId,optional"`
	TraceId	string	`json:"traceId,optional"`
	ActionType	string	`json:"actionType,optional"`
	Status	string	`json:"status,optional"`
	FailureReason	string	`json:"failureReason,optional"`
	MfaStatus	string	`json:"mfaStatus,optional"`
	LoginMethod	string	`json:"loginMethod,optional"`
	RiskScore	int64	`json:"riskScore,optional"`
	RiskLevel	string	`json:"riskLevel,optional"`
	RiskFactors	[]string	`json:"riskFactors,optional"`
	LogHash	string	`json:"logHash,optional"`
	Signature	string	`json:"signature,optional"`
	CreatedAt	string	`json:"createdAt,optional"`
}

type LoginAuditLogGetReq {
	Id	int64	`path:"id,optional"`
	ViewMask	string	`form:"viewMask,optional"`
}



@server (
	prefix: "/admin/v1/login-audit-logs"
	group: login_audit_log
)

service admin-api {
	@handler LoginAuditLogList
	get / (PageRequest) returns (ListLoginAuditLogResponse)

	@handler LoginAuditLogGet
	get /:id (LoginAuditLogGetReq) returns (LoginAuditLog)
}
